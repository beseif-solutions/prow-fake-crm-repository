{
  "type": "credentials",
  "id": "login-credentials",
  "tests": [
    {
      "description": "should succeed with valid credentials",
      "options": {
        "fields": {
          "username": "john.doe",
          "password": "password"
        },
        "write": true
      },
      "result": "success"
    },
    {
      "description": "should validate credentials (from .credentials)",
      "options": {
        "read": true
      },
      "result": "success"
    },
    {
      "description": "should fail with invalid credentials",
      "options": {
        "fields": {
          "username": "fake-username",
          "password": "fake-password"
        }
      },
      "result": "fail"
    }
  ]
}